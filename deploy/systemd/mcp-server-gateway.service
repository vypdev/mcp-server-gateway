[Unit]
Description=MCP Server Gateway for the local host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@MCP_USER@
Group=@MCP_USER@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@CONFIG_FILE@
ExecStart=@INSTALL_DIR@/.venv/bin/mcp-server-gateway
Restart=on-failure
RestartSec=5s

# Keep the service unprivileged and reduce accidental host impact.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=@STATE_DIR@
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
